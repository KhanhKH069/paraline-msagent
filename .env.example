# .env.example — copy thành .env và điền giá trị

# Model
MODEL_PATH=models/pretrained/facebook_nllb-200-distilled-600M
FINETUNED_MODEL_PATH=models/finetuned/best

# Training
WANDB_PROJECT=paraline-nllb
WANDB_ENABLED=false

# Paths
DATA_DIR=data
PROCESSED_DIR=data/processed
RAW_DIR=data/raw

# Hardware
CUDA_VISIBLE_DEVICES=0
