{
  "model_name": "vits2-vietnamese",
  "description": "Single-speaker Vietnamese TTS with PhoBERT",

  "data": {
    "training_files": "dataset/train.txt",
    "validation_files": "dataset/val.txt",
    "text_cleaners": ["vietnamese_cleaners"],
    "max_wav_value": 32768.0,
    "sampling_rate": 22050,
    "filter_length": 1024,
    "hop_length": 256,
    "win_length": 1024,
    "n_mel_channels": 80,
    "mel_fmin": 0.0,
    "mel_fmax": null,
    "add_blank": false,
    "n_speakers": 1,
    "cleaned_text": true
  },

  "model": {
    "use_phobert": true,
    "phobert_model": "vinai/phobert-base-v2",
    "phobert_hidden_size": 768,
    "phobert_freeze_layers": 8,

    "inter_channels": 192,
    "hidden_channels": 192,
    "filter_channels": 768,
    "n_heads": 2,
    "n_layers": 6,
    "kernel_size": 3,
    "p_dropout": 0.1,
    "resblock": "1",
    "resblock_kernel_sizes": [3, 7, 11],
    "resblock_dilation_sizes": [[1,3,5],[1,3,5],[1,3,5]],
    "upsample_rates": [8, 8, 2, 2],
    "upsample_initial_channel": 512,
    "upsample_kernel_sizes": [16, 16, 4, 4],
    "n_layers_q": 3,
    "use_spectral_norm": false,

    "use_transformer_flows": true,
    "transformer_flow_type": "mono_layer_inter_residual",
    "n_flow_layer": 4,

    "use_stochastic_dur_pred": true,
    "dur_predictor_hidden": 192,

    "use_speaker_conditioned_encoder": false,
    "speaker_embedding_dim": 256
  },

  "train": {
    "log_interval": 200,
    "eval_interval": 1000,
    "seed": 1234,
    "epochs": 10000,
    "learning_rate": 2e-4,
    "betas": [0.8, 0.99],
    "eps": 1e-9,
    "batch_size": 16,
    "fp16_run": true,
    "lr_decay": 0.999875,
    "segment_size": 8192,
    "init_lr_ratio": 1,
    "warmup_epochs": 0,
    "c_mel": 45,
    "c_kl": 1.0,
    "use_mel_posterior_encoder": true
  },

  "phoneme": {
    "use_g2p": true,
    "g2p_backend": "vncorenlp",
    "tones": ["ngang","huyen","sac","hoi","nga","nang"],
    "tone_markers": ["", "̀", "́", "̉", "̃", "̣"],
    "initial_consonants": ["b","c","ch","d","đ","g","gh","gi","h","k","kh","l","m","n","ng","ngh","nh","p","ph","qu","r","s","t","th","tr","v","x"],
    "vowels": ["a","ă","â","e","ê","i","o","ô","ơ","u","ư","y"],
    "final_consonants": ["c","ch","m","n","ng","nh","p","t"]
  }
}
